# Facturador backend - configuracion global de la plataforma
#
# Copiar como `.env` y completar con valores locales.
# No guardar secretos reales en Git.
#
# La configuracion comercial/fiscal de cada tenant NO pertenece a este archivo.
# Mercado Pago, ARCA, carpeta Drive, spreadsheet/hoja y refresh tokens se guardan
# cifrados en TenantIntegration desde el panel/admin API.

# -----------------------------------------------------------------------------
# API e infraestructura
# -----------------------------------------------------------------------------

PORT=5000
DATABASE_URL=postgresql://postgres:xfd1048576P!@localhost:5432/facturador?schema=public
REDIS_URL=redis://default:TDYQnOWad4V1z0xB7uGlcZ60d13g8kkh@redis-19365.c74.us-east-1-4.ec2.cloud.redislabs.com:19365

# El proceso `npm run start:workers` solo inicia workers si este valor es `true`.
ENABLE_WORKERS=true

# -----------------------------------------------------------------------------
# Cifrado de integraciones multitenant
# -----------------------------------------------------------------------------

# Clave global usada para cifrar TenantIntegration.secretEnc.
# Debe ser larga, aleatoria, estable y distinta por ambiente.
# Cambiarla sin una migracion/rotacion vuelve ilegibles las credenciales guardadas.
APP_MASTER_KEY=replace-with-a-long-random-secret

# -----------------------------------------------------------------------------
# Autenticacion
# -----------------------------------------------------------------------------

# Usar secretos distintos entre si y distintos de APP_MASTER_KEY.
ADMIN_TOKEN_SECRET=replace-with-a-long-random-admin-token-secret
TENANT_TOKEN_SECRET=replace-with-a-long-random-tenant-token-secret

ADMIN_TOKEN_TTL_HOURS=12
TENANT_TOKEN_TTL_HOURS=12

# -----------------------------------------------------------------------------
# Google OAuth de la plataforma
# -----------------------------------------------------------------------------

# Estas credenciales identifican a la aplicacion OAuth compartida.
# El refresh token y los destinos Drive/Sheets se almacenan por tenant.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_STATE_SECRET=replace-with-a-long-random-google-state-secret

# Debe coincidir exactamente con un redirect URI autorizado en Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:5000/google/oauth/callback

# -----------------------------------------------------------------------------
# Seed local opcional
# -----------------------------------------------------------------------------

# Solo se usan al ejecutar el seed para inicializar el checkpoint de un tenant.
# Dejarlas vacias si no se necesita sembrar un checkpoint de Mercado Pago.
SEED_MP_TENANT_SLUG=
SEED_MP_CHECKPOINT_TIMESTAMP=
SEED_MP_CHECKPOINT_PAYMENT_ID=

# -----------------------------------------------------------------------------
# Configuracion que NO debe agregarse globalmente
# -----------------------------------------------------------------------------
#
# Mercado Pago por tenant:
#   ACCESS_TOKEN, POS_ID, API_URL, POLLING_INTERVAL_MS
#
# ARCA por tenant:
#   CUIT, PTO_VTA, CBTE_TIPO, ALIC_IVA, WSAA_URL, WSFE_URL,
#   CERT_PATH/KEY_PATH o CERT_B64/KEY_B64
#
# Google por tenant:
#   REFRESH_TOKEN, DRIVE_FOLDER_ID, SHEETS_ID, SHEET_NAME
#
