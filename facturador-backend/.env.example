# Facturador backend - configuracion global de la plataforma
#
# Copiar como `.env` y completar con valores locales.
# No guardar secretos reales en Git.
#
# La configuracion comercial/fiscal de cada tenant NO pertenece a este archivo.
# Mercado Pago, ARCA, carpeta Drive, spreadsheet/hoja y refresh tokens se guardan
# cifrados en TenantIntegration desde el panel/admin API.

# -----------------------------------------------------------------------------
# API e infraestructura
# -----------------------------------------------------------------------------

PORT=5000
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/facturador?schema=public"
REDIS_URL=redis://localhost:6379

# El proceso `npm run start:workers` solo inicia workers si este valor es `true`.
ENABLE_WORKERS=true

# -----------------------------------------------------------------------------
# Cifrado de integraciones multitenant
# -----------------------------------------------------------------------------

# Clave global usada para cifrar TenantIntegration.secretEnc.
# OBLIGATORIA EN PRODUCCION. Debe ser larga, aleatoria, estable y distinta por ambiente.
# Si no se define, el codigo usa el fallback de desarrollo "dev-master-key", que NO es
# seguro: cualquiera con acceso a la DB podria descifrar las credenciales.
# Cambiarla sin una migracion/rotacion vuelve ilegibles las credenciales guardadas:
# si una base ya tiene secretos cifrados con "dev-master-key", definir otra clave
# requiere re-cifrarlos primero (no basta con cambiar este valor).
APP_MASTER_KEY=replace-with-a-long-random-secret

# -----------------------------------------------------------------------------
# Autenticacion
# -----------------------------------------------------------------------------

# OBLIGATORIOS EN PRODUCCION. Usar secretos distintos entre si y distintos de
# APP_MASTER_KEY. Sin ellos se usan fallbacks de desarrollo (o APP_MASTER_KEY) y los
# tokens de sesion admin/portal podrian falsificarse. Cambiarlos solo invalida
# las sesiones abiertas (no afecta datos cifrados).
ADMIN_TOKEN_SECRET=replace-with-a-long-random-admin-token-secret
TENANT_TOKEN_SECRET=replace-with-a-long-random-tenant-token-secret

ADMIN_TOKEN_TTL_HOURS=12
TENANT_TOKEN_TTL_HOURS=12

# Email transaccional con Resend. EMAIL_FROM debe usar exactamente un dominio
# verificado en Resend. PUBLIC_APP_URL se usa para construir el enlace.
RESEND_API_KEY=
EMAIL_FROM=Facturador <onboarding@tu-dominio.com>
PUBLIC_APP_URL=http://localhost:5173

# SOLO desarrollo local: si vale exactamente `true`, /public/register y
# /public/resend-verification devuelven el token de verificacion en la respuesta
# y el frontend (solo en `vite dev`) muestra un boton para verificar sin email.
# Permite verificar cualquier email registrado: NUNCA habilitarlo en staging ni
# produccion. Ausente o cualquier otro valor = deshabilitado.
EXPOSE_DEV_VERIFICATION=false

# Cobro comercial de Facturador mediante Mercado Pago Suscripciones.
# Es una credencial global de la cuenta vendedora de Facturador, distinta de las
# credenciales POS de cada tenant. Los precios USD se convierten a ARS usando
# la cotizacion billete vendedor publicada por Banco Nacion.
MP_BILLING_ACCESS_TOKEN=
MP_BILLING_API_URL=https://api.mercadopago.com
BILLING_BACK_URL=http://localhost:5173/portal-cliente/suscripcion
BNA_EXCHANGE_RATE_URL=https://www.bna.com.ar/Personas

# -----------------------------------------------------------------------------
# Google OAuth de la plataforma
# -----------------------------------------------------------------------------

# Estas credenciales identifican a la aplicacion OAuth compartida.
# El refresh token y los destinos Drive/Sheets se almacenan por tenant.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_STATE_SECRET=replace-with-a-long-random-google-state-secret

# Debe coincidir exactamente con un redirect URI autorizado en Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:5000/google/oauth/callback

# Opcional en desarrollo: URL publica (ngrok) usada como base del redirect OAuth
# cuando GOOGLE_REDIRECT_URI no esta definida.
NGROK_URL=

# -----------------------------------------------------------------------------
# Endpoints de plataforma (Mercado Pago POS / ARCA)
# -----------------------------------------------------------------------------

# API de Mercado Pago usada para leer los pagos POS de cada tenant con SU propio
# access token. Si se omite se usa https://api.mercadopago.com.
MP_API_URL=https://api.mercadopago.com

# Endpoints ARCA por defecto (homologacion en este ejemplo). Cada tenant puede
# elegir ambiente con ENV=homologacion|produccion o URLs propias (WSAA_URL/WSFE_URL)
# en su integracion AFIP; eso tiene prioridad sobre estos valores.
AFIP_WSAA_URL=https://wsaahomo.afip.gov.ar/ws/services/LoginCms
AFIP_WSFE_URL=https://wswhomo.afip.gov.ar/wsfev1/service.asmx
# Bandera de seguridad para scripts de prueba (invoice:test-flow se niega a correr si es true).
AFIP_PRODUCTION=false

# -----------------------------------------------------------------------------
# Seed local opcional
# -----------------------------------------------------------------------------

# Solo se usan al ejecutar el seed para inicializar el checkpoint de un tenant.
# Dejarlas vacias si no se necesita sembrar un checkpoint de Mercado Pago.
SEED_MP_TENANT_SLUG=
SEED_MP_CHECKPOINT_TIMESTAMP=
SEED_MP_CHECKPOINT_PAYMENT_ID=

# -----------------------------------------------------------------------------
# Configuracion que NO debe agregarse globalmente
# -----------------------------------------------------------------------------
#
# Mercado Pago por tenant:
#   ACCESS_TOKEN, POS_ID, API_URL, POLLING_INTERVAL_MS
#
# ARCA por tenant:
#   CUIT, PTO_VTA, CBTE_TIPO, ALIC_IVA, WSAA_URL, WSFE_URL,
#   CERT_PATH/KEY_PATH o CERT_B64/KEY_B64
#
# Google por tenant:
#   REFRESH_TOKEN, DRIVE_FOLDER_ID, SHEETS_ID, SHEET_NAME
#
# Variables legacy (single-tenant) RETIRADAS: el codigo ya no las lee y no deben
# volver a agregarse. Si un tenant no tiene sus credenciales en la DB, se saltea
# con un error claro; nunca se usan valores del .env como respaldo.
#   CUIT, MP_ACCESS_TOKEN, MP_PUBLIC_KEY, MP_POLLING_INTERVAL, MP_POS_ID,
#   AFIP_TRA_PATH, AFIP_TRACMS_PATH, AFIP_CERT_PATH, AFIP_KEY_PATH, AFIP_TA_PATH,
#   AFIP_PTO_VTA, AFIP_CBTE_TIPO, AFIP_ALIC_IVA, AFIP_*_B64, GOOGLE_TOKEN_PATH,
#   DRIVE_FOLDER_ID, SHEET_ID, SHEET_NAME, DEFAULT_TENANT_SLUG
#
